// ════════════════════════════════════════════════════════════
//  PCSS.compute — 屏幕空间 Percentage-Closer Soft Shadows
//
//  Kernel: CS_PCSS_Main [numthreads(8,8,1)]
//  输入：_CameraDepthTexture, _MainLightShadowmapTexture
//  输出：_PCSS_SoftShadow (RWTexture2D<float>)
//
//  算法流程 per pixel:
//    深度重建世界坐标 → 级联选择 → 硬阴影测试 →
//    Blocker Search（Vogel 盘采样） → Penumbra 估算 → 变核 PCF
// ════════════════════════════════════════════════════════════

#pragma kernel CS_PCSS_Main

// ═══ 输入纹理 ═══
Texture2D           _CameraDepthTexture;
Texture2D           _MainLightShadowmapTexture;
SamplerComparisonState sampler_MainLightShadowmapTexture;  // 用于深度比较
SamplerState        sampler_PointClamp;                     // 用于原始深度读取

// ═══ 输出 ═══
RWTexture2D<float>  _PCSS_SoftShadow;

// ═══ 级联数据 ═══
float4x4  _PCSS_WorldToShadowMatrices[4];
float4    _PCSS_CascadeSplits;
int       _PCSS_CascadeCount;
float     _PCSS_ShadowDistance;

// ═══ 相机矩阵 ═══
float4x4  _PCSS_InvProj;
float4x4  _PCSS_ViewToWorld;

// ═══ PCSS 参数 ═══
float     _PCSS_LightSize;
int       _PCSS_BlockerSamples;
int       _PCSS_BlockerRadius;
int       _PCSS_PCFSamples;
float     _PCSS_Softness;
float2    _PCSS_ScreenSize;

// ════════════════════════════════════════════════════════════
//  Vogel Disk 32 点 — Blocker Search 与 PCF 共用
//  θ = i × 137.508° (golden angle), r = √((i+0.5)/N)
// ════════════════════════════════════════════════════════════
static const float2 VogelDisk[32] =
{
    float2(0.0284,  0.1087),  float2( 0.1766,  0.0676),  float2(-0.1744,  0.1780),  float2( 0.0210, -0.2479),
    float2(-0.2168, -0.1762),  float2(-0.0368,  0.3060),  float2( 0.1458, -0.2791),  float2( 0.2927,  0.0888),
    float2(-0.3105,  0.0397),  float2( 0.1648,  0.3230),  float2(-0.0347, -0.4025),  float2(-0.2360, -0.3356),
    float2(-0.4092, -0.0566),  float2(-0.2305,  0.3875),  float2( 0.1669, -0.4405),  float2( 0.3942, -0.2468),
    float2(-0.3678, -0.2440),  float2( 0.3264,  0.2472),  float2(-0.3033,  0.3505),  float2( 0.0359, -0.5256),
    float2( 0.4130, -0.4186),  float2(-0.3752, -0.3988),  float2( 0.1697,  0.4868),  float2( 0.3826,  0.3261),
    float2(-0.4990, -0.1348),  float2( 0.4773, -0.1076),  float2(-0.2348, -0.5315),  float2(-0.3548,  0.4740),
    float2( 0.4941, -0.2563),  float2(-0.4674, -0.3919),  float2(-0.0510,  0.5771),  float2( 0.2900, -0.5407)
};

// ════════════════════════════════════════════════════════════
//  深度 → 世界坐标
// ════════════════════════════════════════════════════════════
float3 ReconstructWorldPos(float2 uv, float rawDepth)
{
    float4 ndc = float4(uv * 2.0 - 1.0, rawDepth, 1.0);
#if UNITY_UV_STARTS_AT_TOP
    ndc.y = -ndc.y;
#endif
    float4 viewPos = mul(_PCSS_InvProj, ndc);
    viewPos /= viewPos.w;
    return mul(_PCSS_ViewToWorld, float4(viewPos.xyz, 1.0)).xyz;
}

// ════════════════════════════════════════════════════════════
//  级联选择 — 根据视图空间深度
// ════════════════════════════════════════════════════════════
int SelectCascade(float viewZ)
{
    int idx = 0;
    for (int c = 0; c < _PCSS_CascadeCount - 1; c++)
    {
        if (viewZ > _PCSS_CascadeSplits[c])
            idx = c + 1;
    }
    return idx;
}

// ════════════════════════════════════════════════════════════
//  CS_PCSS_Main — 主 PCSS 内核
// ════════════════════════════════════════════════════════════
[numthreads(8, 8, 1)]
void CS_PCSS_Main(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_PCSS_ScreenSize.x || id.y >= (uint)_PCSS_ScreenSize.y)
        return;

    // ── 1. 深度 → 世界坐标 ──
    float2 uv = (id.xy + 0.5) / _PCSS_ScreenSize;
    float rawDepth = _CameraDepthTexture.SampleLevel(sampler_PointClamp, uv, 0).r;

    // 天空 / 远平面 → 全亮
    if (rawDepth >= 0.9999)
    {
        _PCSS_SoftShadow[id.xy] = 1.0;
        return;
    }

    float3 worldPos = ReconstructWorldPos(uv, rawDepth);

    // ── 2. 级联选择 ──
    // 视图空间深度（用于级联选择）
    float4 viewPos = mul(_PCSS_InvProj, float4(uv * 2.0 - 1.0, rawDepth, 1.0));
#if UNITY_UV_STARTS_AT_TOP
    viewPos.y = -viewPos.y;
#endif
    viewPos /= viewPos.w;
    float viewZ = -viewPos.z; // Unity Forward 方向

    int cascadeIdx = SelectCascade(viewZ);
    cascadeIdx = clamp(cascadeIdx, 0, _PCSS_CascadeCount - 1);

    // ── 3. 世界 → Shadow Atlas UV ──
    float4 shadowCoord = mul(_PCSS_WorldToShadowMatrices[cascadeIdx], float4(worldPos, 1.0));
    float3 shadowUVW = shadowCoord.xyz / max(0.00001, shadowCoord.w);
    // shadowUVW.xy = Atlas UV (已含级联偏移), shadowUVW.z = 接收物深度 [0,1]

    // UV 边界裁剪（级联边界外的像素回到硬阴影）
    if (shadowUVW.x < 0.0 || shadowUVW.x > 1.0 || shadowUVW.y < 0.0 || shadowUVW.y > 1.0)
    {
        _PCSS_SoftShadow[id.xy] = 1.0;
        return;
    }

    float receiverDepth = shadowUVW.z;

    // ── 4. 硬阴影测试 ──
    float bias = 0.001;
    float hardShadow = _MainLightShadowmapTexture.SampleCmpLevelZero(
        sampler_MainLightShadowmapTexture, shadowUVW.xy, receiverDepth - bias);

    if (hardShadow > 0.99)
    {
        _PCSS_SoftShadow[id.xy] = 1.0;
        return;
    }

    // ── 5. Blocker Search（Vogel 盘，Shadow Map UV 空间）──
    float avgBlockerDepth = 0.0;
    int   blockerCount    = 0;

    float searchRadiusUV = (float)_PCSS_BlockerRadius / 2048.0;

    for (int i = 0; i < _PCSS_BlockerSamples; i++)
    {
        float2 offset = VogelDisk[i] * searchRadiusUV * receiverDepth;
        float2 sampleUV = shadowUVW.xy + offset;

        // 硬阴影比较
        float isBlocked = _MainLightShadowmapTexture.SampleCmpLevelZero(
            sampler_MainLightShadowmapTexture, sampleUV, receiverDepth - bias);

        if (isBlocked < 0.01) // 被遮挡 → 是 blocker
        {
            // 读取该 blocker 的原始深度
            float blockerD = _MainLightShadowmapTexture.SampleLevel(
                sampler_PointClamp, sampleUV, 0).r;
            avgBlockerDepth += blockerD;
            blockerCount++;
        }
    }

    if (blockerCount == 0)
    {
        _PCSS_SoftShadow[id.xy] = 0.0; // 全影（无半影区域）
        return;
    }
    avgBlockerDepth /= (float)blockerCount;

    // ── 6. Penumbra 估算 ──
    float penumbra = (receiverDepth - avgBlockerDepth) / max(0.0001, avgBlockerDepth);
    penumbra *= _PCSS_LightSize * _PCSS_Softness;

    // 映射到 Shadow Map UV 空间像素
    float penumbraUV = penumbra / 2048.0;

    // 限制最大 PCF 半径，避免过度模糊
    penumbraUV = min(penumbraUV, (float)_PCSS_BlockerRadius / 2048.0);

    // ── 7. 变核 PCF ──
    float shadow = 0.0;
    for (int j = 0; j < _PCSS_PCFSamples; j++)
    {
        float2 offset = VogelDisk[j] * penumbraUV;
        float2 sampleUV = shadowUVW.xy + offset;
        shadow += _MainLightShadowmapTexture.SampleCmpLevelZero(
            sampler_MainLightShadowmapTexture, sampleUV, receiverDepth - bias);
    }
    shadow /= (float)_PCSS_PCFSamples;

    _PCSS_SoftShadow[id.xy] = shadow;
}
