// ════════════════════════════════════════════════════════════
//  IFFT2D — 二维逆 FFT（groupshared-memory Cooley-Tukey）
//
//  将频域波谱变换到空间域位移场。
//  2D FFT = 水平 1D FFT + 垂直 1D FFT，各 1 次 Dispatch。
//
//  每 thread group 处理一整行/列 (256 元素)，
//  8 个 butterfly stage 全部在 groupshared memory 内完成。
//
//  Dispatch: 水平 (1,256,1), 垂直 (256,1,1)
//           group.y/x = 行/列索引, thread.x = 元素索引
// ════════════════════════════════════════════════════════════

#pragma kernel CSMain

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"

// ── 输入/输出（ping-pong）──
Texture2D<float4> _Input;
RWTexture2D<float4> _Output;

// ── 参数 ──
uint _Direction;    // 0 = 水平, 1 = 垂直
uint _Resolution;   // 256
uint _Inv;          // 1 = IFFT (twiddle 取正角度)

#define N 256
#define LOG2N 8

groupshared float2 g_Data[N];

// ════════════════════════════════════════════════════════════
//  CSMain — 1 thread group / row-or-col, 256 threads
// ════════════════════════════════════════════════════════════
[numthreads(N, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID, uint3 group : SV_GroupID, uint3 thread : SV_GroupThreadID)
{
    uint t = thread.x;

    // ── 1. 加载到 groupshared memory ──
    uint2 coord;
    if (_Direction == 0)
        coord = uint2(t, group.y);     // 水平: [col, row]
    else
        coord = uint2(group.x, t);     // 垂直: [col, row]

    float4 val = _Input.Load(uint3(coord, 0));
    g_Data[t] = val.rg;               // 只取 RG (复数)
    GroupMemoryBarrierWithGroupSync();

    // ── 2. 8-stage Cooley-Tukey butterfly ──
    for (uint s = 0; s < LOG2N; s++)
    {
        uint halfBlock = 1u << s;

        // 线程 t 的 bit s 为 0 时参与蝶形运算
        if ((t & halfBlock) == 0)
        {
            uint idx0 = t;
            uint idx1 = t | halfBlock;

            float2 v0 = g_Data[idx0];
            float2 v1 = g_Data[idx1];

            // Twiddle: W = exp(sign · 2πi · (t & (halfBlock-1)) / (halfBlock<<1))
            // sign: IFFT = +1, FFT = -1
            uint   k     = t & (halfBlock - 1u);
            float  angle = k * 2.0 * PI / (float)(halfBlock << 1u);
            if (_Inv) angle = angle;   // IFFT: exp(+iθ)
            else      angle = -angle;  // FFT:  exp(-iθ)

            float sinW, cosW;
            sincos(angle, sinW, cosW);

            // W · v1
            float2 twV1;
            twV1.x = cosW * v1.x - sinW * v1.y;
            twV1.y = cosW * v1.y + sinW * v1.x;

            g_Data[idx0] = v0 + twV1;
            g_Data[idx1] = v0 - twV1;
        }
        GroupMemoryBarrierWithGroupSync();
    }

    // ── 3. 写回 ──
    _Output[coord] = float4(g_Data[t], 0, 0);
}
