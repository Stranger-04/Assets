#pragma kernel CS_RainUpdate

struct RainParticle
{
    float3 position;
    float3 velocity;
};

RWStructuredBuffer<RainParticle> _RainBuffer;

float _DeltaTime;
int   _InstanceCount;

float3 _SpawnCenter;     // transform.position
float3 _SpawnRight;      // transform.right
float3 _SpawnUp;         // transform.up
float3 _SpawnForward;    // transform.forward
float3 _SpawnArea;       // x=Xradius, y=fallDistance, z=Zradius

float4 _ForceFields[16];
int _ForceFieldCount;

// Simple GPU hash for pseudo-random values per particle
float RainRand(uint seed, uint offset)
{
    uint n = seed * 110045u + offset * 12345u;
    n = (n << 13) ^ n;
    n = n * (n * n * 15731u + 789221u) + 1376312589u;
    return float(n & 0x7fffffffu) / float(0x7fffffffu);
}

[numthreads(64, 1, 1)]
void CS_RainUpdate(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= (uint)_InstanceCount) return;

    RainParticle p = _RainBuffer[i];

    // Sum all active force fields
    float3 totalForce = float3(0, 0, 0);
    for (int j = 0; j < _ForceFieldCount && j < 16; j++)
    {
        totalForce += _ForceFields[j].xyz;
    }

    // Apply acceleration and update position
    p.velocity += totalForce * _DeltaTime;
    p.position += p.velocity * _DeltaTime;

    // Reset when particle falls below the fall zone
    float yLocal = dot(p.position - _SpawnCenter, _SpawnUp);
    if (yLocal < -_SpawnArea.y)
    {
        float rx = (RainRand(i, 0) * 2.0 - 1.0) * _SpawnArea.x * 0.5;
        float rz = (RainRand(i, 1) * 2.0 - 1.0) * _SpawnArea.z * 0.5;
        // Tiny jitter at the emission plane to stagger particle appearance
        float ry = -RainRand(i, 2) * 0.1;

        p.position = _SpawnCenter
            + _SpawnRight   * rx
            + _SpawnUp      * ry
            + _SpawnForward * rz;

        p.velocity = totalForce * float3(1, 0, 1);
    }

    _RainBuffer[i] = p;
}
